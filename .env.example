# Desarrollo local: conserva el selector de actores para UAT.
VITE_SCM_AUTH_MODE=local_actor
VITE_API_URL=http://localhost:5000
# Estación local que renderiza e imprime las preetiquetas SCM.
VITE_SCM_WEIGHING_STATION_URL=http://127.0.0.1:5050/

# Para probar autenticación real también en localhost, cambia el modo a
# supabase y completa únicamente valores públicos del proyecto.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
